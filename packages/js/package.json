{
  "name": "@b4moss/crudian",
  "version": "0.0.0",
  "description": "CRUD abstraction for DDD repositories",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bun-sqlite": {
      "types": "./dist/bun-sqlite/index.d.ts",
      "import": "./dist/bun-sqlite/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle/index.d.ts",
      "import": "./dist/drizzle/index.js"
    },
    "./prisma": {
      "types": "./dist/prisma/index.d.ts",
      "import": "./dist/prisma/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "bun test"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "keywords": [
    "crud",
    "repository",
