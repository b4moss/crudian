    "bun",
    "drizzle",
    "prisma",
    "ddd"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b4m-oss/crudian.git",
    "directory": "packages/js"
  },
  "publishConfig": {
    "access": "public"
  }
