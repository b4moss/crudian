{
  "name": "@b4moss/crudian",
  "version": "0.2.0",
  "description": "CRUD abstraction for DDD repositories",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bun-sqlite": {
      "types": "./dist/bun-sqlite/index.d.ts",
      "bun": "./dist/bun-sqlite/index.js",
      "import": "./dist/bun-sqlite/node-stub.js",
      "default": "./dist/bun-sqlite/node-stub.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle/index.d.ts",
      "import": "./dist/drizzle/index.js",
      "default": "./dist/drizzle/index.js"
    },
    "./prisma": {
      "types": "./dist/prisma/index.d.ts",
      "import": "./dist/prisma/index.js",
      "default": "./dist/prisma/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun run test:bun-sqlite",
    "test:bun-sqlite": "bun test src/bun-sqlite",
    "test:drizzle": "node --test --experimental-strip-types src/drizzle/**/*.test.ts",
    "test:prisma": "node --test --experimental-strip-types src/prisma/**/*.test.ts"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "bun-types": "^1.2.0",
    "typescript": "^5.8.0"
  },
  "keywords": [
    "crud",
    "repository",
    "sqlite",
    "bun",
    "drizzle",
    "prisma",
    "ddd"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b4moss/crudian.git",
    "directory": "packages/js"
  },
  "publishConfig": {
    "access": "public"
  }
}
