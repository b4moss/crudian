generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Fixture model for adapter tests / client generation (raw SQL uses table `items`).
model Item {
  id    Int     @id @default(autoincrement())
  name  String
  score Int?
  note  String?

  @@map("items")
}
